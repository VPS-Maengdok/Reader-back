DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_URL=postgresql://{DATABASE_USER}:{DATABASE_PASSWORD}@{HOST}/{DATABASE_NAME}

# Port the app listens on (prod: 3999, matches the Traefik label)
PORT=3999

# Comma-separated list of origins allowed by CORS
ALLOW_ORIGINS=

# JWT_SECRET and ADMIN_PASSWORD must be at least 16 characters:
# the app refuses to start otherwise. If a value contains "$", single-quote it.
JWT_SECRET=

ADMIN_USERNAME=
ADMIN_PASSWORD=

DOMAIN=
